<div class="profile-card">

    <!-- Profile Photo -->
    <div class="profile-photo-container">
        <img src="<%= user.profilePhoto %>" alt="Profile Photo" class="profile-photo">
    </div>

    <!-- Full Name -->
    <h2 class="profile-name">
        <%= user.firstName %>
        <% if (user.middleName) { %>
            <%= " " + user.middleName %>
        <% } %>
        <%= " " + user.surname %>
    </h2>

    <!-- College Name -->
    <p class="profile-college">
        <% if (user.college === "other" && user.otherCollege) { %>
            <%= user.otherCollege %>
        <% } else { %>
            <%= user.college %>
        <% } %>
    </p>

    <!-- Premium text (Optional) -->
    <p class="premium-status">
        <span>👑</span> Premium Account
    </p>

    <hr class="divider">

    <a href="/edit-profile" class="edit-profile-btn">Edit Profile</a>



</div>
